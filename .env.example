# Copy this file to .env on the host (never commit .env — it's gitignored).
#   cp .env.example .env
# Then fill in the real values below.

# Required — get this from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# Optional — pages fetched per platform per scheduled run. Default: 2.
PAGES_PER_SCRAPE=2

# Optional — log every generated SQL statement. Keep false in production.
DB_ECHO=false

# Not needed here — docker-compose.yml sets DATABASE_URL directly so the
# sqlite file lives in the bind-mounted ./data volume and survives
# redeploys. Only set this if you're running the bot outside Docker Compose
# (e.g. `uv run python bot.py` directly) or pointing at Postgres instead:
# DATABASE_URL=sqlite+aiosqlite:///./scraper_jobs.db
