# Copy this file to .env on the host (never commit .env — it's gitignored).
#   cp .env.example .env
# Then fill in the real values below.

# Required — get this from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# Required — comma-separated Telegram user IDs allowed to use the bot.
# Fail-closed: if this is empty, EVERYONE is rejected (and logged at
# WARNING with their user_id, so you can discover your own ID on first
# contact and add it here).
ALLOWED_USER_IDS=

# Required for admin features (/health, /diag, error alerts, pages=0).
# A single Telegram user ID. Always implicitly allowed even if omitted
# from ALLOWED_USER_IDS above.
ADMIN_USER_ID=

# Optional — pages fetched per platform per scheduled run. Default: 2.
PAGES_PER_SCRAPE=2

# Optional — input limits enforced by the /track conversation. Defaults
# shown are the out-of-the-box values.
MIN_QUERY_LENGTH=2
MAX_QUERY_LENGTH=100
MAX_TIMES_PER_JOB=6
MAX_ACTIVE_JOBS_PER_USER=10
MAX_JOB_DURATION_DAYS=90

# Optional — log every generated SQL statement. Keep false in production.
DB_ECHO=false

# Not needed here — docker-compose.yml sets DATABASE_URL directly so the
# sqlite file lives in the bind-mounted ./data volume and survives
# redeploys. Only set this if you're running the bot outside Docker Compose
# (e.g. `uv run python bot.py` directly) or pointing at Postgres instead:
# DATABASE_URL=sqlite+aiosqlite:///./scraper_jobs.db
