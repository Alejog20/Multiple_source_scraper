# Copy this file to .env on the host (never commit .env — it's gitignored).
#   cp .env.example .env
# Then fill in the real values below.

# Required — get this from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# Required — comma-separated Telegram user IDs allowed to use the bot.
# Fail-closed: if this is empty, EVERYONE is rejected (and logged at
# WARNING with their user_id, so you can discover your own ID on first
# contact and add it here).
ALLOWED_USER_IDS=

# Required for admin features (/health, /diag, error alerts, pages=0).
# A single Telegram user ID. Always implicitly allowed even if omitted
# from ALLOWED_USER_IDS above.
ADMIN_USER_ID=

# Optional — IANA zone name used to interpret HH:MM run times entered via
# /track. Jobs created before this feature existed keep running in UTC
# (stored per-job in the database) regardless of this value.
BOT_TIMEZONE=America/Bogota

# Optional — pages fetched per platform per scheduled run. Default: 2.
PAGES_PER_SCRAPE=2

# Optional — input limits enforced by the /track conversation. Defaults
# shown are the out-of-the-box values.
MIN_QUERY_LENGTH=2
MAX_QUERY_LENGTH=100
MAX_TIMES_PER_JOB=6
MAX_ACTIVE_JOBS_PER_USER=10
MAX_JOB_DURATION_DAYS=90

# Optional — build/deploy commit SHA, shown by /health. Injected by the
# Docker build (ARG/ENV GIT_SHA) — leave blank for local runs.
GIT_SHA=

# Optional — dead-man's-switch URL (e.g. a healthchecks.io check). If set,
# the bot GETs it every 10 minutes; if the bot dies, that service notices
# the check-ins stop and can alert you by email/push.
HEARTBEAT_URL=

# Optional — sentinel file touched every 5 minutes, used by Docker's
# HEALTHCHECK to detect a frozen event loop. Default matches
# docker-compose.yml; only override if you changed one without the other.
HEALTH_FILE=/tmp/bot_healthy

# Optional, unused for now — HTTPS proxy for Amazon requests only (e.g. a
# residential proxy), in case scripts/probe_amazon.py shows EC2's IP gets
# blocked while a residential IP doesn't. Not wired into AmazonScraper
# yet — see docs/amazon-access-test.md. Format: http://user:pass@host:port
HTTPS_PROXY_AMAZON=

# Optional — log every generated SQL statement. Keep false in production.
DB_ECHO=false

# Not needed here — docker-compose.yml sets DATABASE_URL directly so the
# sqlite file lives in the bind-mounted ./data volume and survives
# redeploys. Only set this if you're running the bot outside Docker Compose
# (e.g. `uv run python bot.py` directly) or pointing at Postgres instead:
# DATABASE_URL=sqlite+aiosqlite:///./scraper_jobs.db
